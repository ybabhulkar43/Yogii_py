{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "Yogii-ETE-ADF"
		},
		"AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage1'"
		},
		"AzureBlobStorage2_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage2'"
		},
		"AzureDataLakeStorage1_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage1'"
		},
		"MySql1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'MySql1'"
		},
		"MySql2_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'MySql2'"
		},
		"MySql3_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'MySql3'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://yogiistorageacc.dfs.core.windows.net/"
		},
		"MySql1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"MySql1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sales"
		},
		"MySql1_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "root"
		},
		"MySql2_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"MySql2_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sales"
		},
		"MySql2_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "root"
		},
		"MySql3_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"MySql3_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sales"
		},
		"MySql3_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "root"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "Yogii-ETE-ADF_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage1_connectionString": {
						"value": "[parameters('AzureBlobStorage1_connectionString')]"
					},
					"AzureBlobStorage2_connectionString": {
						"value": "[parameters('AzureBlobStorage2_connectionString')]"
					},
					"AzureDataLakeStorage1_accountKey": {
						"value": "[parameters('AzureDataLakeStorage1_accountKey')]"
					},
					"MySql2_password": {
						"value": "[parameters('MySql2_password')]"
					},
					"MySql1_password": {
						"value": "[parameters('MySql1_password')]"
					},
					"MySql3_password": {
						"value": "[parameters('MySql3_password')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"MySql2_properties_typeProperties_server": {
						"value": "[parameters('MySql2_properties_typeProperties_server')]"
					},
					"MySql2_properties_typeProperties_database": {
						"value": "[parameters('MySql2_properties_typeProperties_database')]"
					},
					"MySql2_properties_typeProperties_username": {
						"value": "[parameters('MySql2_properties_typeProperties_username')]"
					},
					"MySql1_properties_typeProperties_server": {
						"value": "[parameters('MySql1_properties_typeProperties_server')]"
					},
					"MySql1_properties_typeProperties_database": {
						"value": "[parameters('MySql1_properties_typeProperties_database')]"
					},
					"MySql1_properties_typeProperties_username": {
						"value": "[parameters('MySql1_properties_typeProperties_username')]"
					},
					"MySql3_properties_typeProperties_server": {
						"value": "[parameters('MySql3_properties_typeProperties_server')]"
					},
					"MySql3_properties_typeProperties_database": {
						"value": "[parameters('MySql3_properties_typeProperties_database')]"
					},
					"MySql3_properties_typeProperties_username": {
						"value": "[parameters('MySql3_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}